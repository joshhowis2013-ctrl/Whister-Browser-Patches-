<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>WhisterAnimatedSetup</AssemblyName>
    <ApplicationIcon>..\whister.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WhisterPayloadFileCount" Value="$(WhisterPayloadFileCount)" />
    <AssemblyMetadata Include="WhisterPayloadSizeBytes" Value="$(WhisterPayloadSizeBytes)" />
    <AssemblyMetadata Include="WhisterBackendSizeBytes" Value="$(WhisterBackendSizeBytes)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(InstallerPayloadPath)" LogicalName="WhisterAnimatedInstaller.Payload.exe" />
  </ItemGroup>
</Project>
