<Window x:Class="WhisterAnimatedInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whister Setup" Width="860" Height="700" MinWidth="760" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
  <Window.Resources>
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7FF" />
      <Setter Property="Background" Value="#201E2C" />
      <Setter Property="BorderBrush" Value="#444052" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CaretBrush" Value="#93C5FD" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Border CornerRadius="20" Background="#15141D" BorderBrush="#343140" BorderThickness="1">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#1B1924" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              CornerRadius="20,20,0,0">
        <Grid Margin="24,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="9" Background="#2563EB">
              <TextBlock Text="W" FontSize="16" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="  WHISTER  /  SETUP" Foreground="#C8C4D5" FontSize="11"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="CloseButton" Content="×" Style="{StaticResource QuietButton}"
                  Padding="10,4" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="CloseButton_Click" AutomationProperties.Name="Close setup" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="56,30,56,22">
        <Grid x:Name="WelcomePage" Opacity="0">
          <Grid.RenderTransform><TranslateTransform Y="12" /></Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" MaxWidth="580">
            <Border x:Name="WelcomeBadge" Width="66" Height="66" CornerRadius="22" Background="#192D49"
                    RenderTransformOrigin="0.5,0.5"
                    HorizontalAlignment="Left" Margin="0,0,0,26">
              <Border.RenderTransform><ScaleTransform x:Name="WelcomeBadgeScale" /></Border.RenderTransform>
              <TextBlock Text="W" FontSize="36" FontWeight="Bold" Foreground="#93C5FD"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="A calmer way to browse." Style="{StaticResource BodyText}"
                       FontSize="38" FontWeight="SemiBold" />
            <TextBlock Text="Whister is a Chromium-based browser for Windows, with uBlock Origin included. This setup installs it for your Windows account and checks the space needed before it begins."
                       Style="{StaticResource SmallText}" FontSize="16" Margin="0,14,0,0" MaxWidth="530" />
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
              <Border Background="#242130" CornerRadius="9" Padding="11,7" Margin="0,0,9,0">
                <TextBlock Text="uBlock Origin included" Foreground="#C0DBFF" FontSize="12" />
              </Border>
              <Border Background="#242130" CornerRadius="9" Padding="11,7">
                <TextBlock Text="Per-user install" Foreground="#C0DBFF" FontSize="12" />
              </Border>
            </StackPanel>
          </StackPanel>
          <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Bottom">
            <TextBlock Text="A few quick choices, then you're ready." Style="{StaticResource SmallText}"
                       VerticalAlignment="Center" />
            <Button Content="Let's set it up  →" HorizontalAlignment="Right" Click="OptionsButton_Click"
                    DockPanel.Dock="Right" />
          </DockPanel>
        </Grid>

        <Grid x:Name="OptionsPage" Opacity="0" Visibility="Collapsed">
          <Grid.RenderTransform><TranslateTransform Y="12" /></Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" MaxWidth="640">
            <TextBlock Text="YOUR SETUP" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Make it yours." Style="{StaticResource BodyText}" FontSize="34"
                       FontWeight="SemiBold" Margin="0,9,0,7" />
            <TextBlock Text="Choose where Whister lives on this PC. You can keep using your browser while setup runs."
                       Style="{StaticResource SmallText}" Margin="0,0,0,24" />
            <TextBlock Text="INSTALL LOCATION" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"
                       Margin="0,0,0,9" />
            <DockPanel>
              <Button Content="Browse…" Style="{StaticResource QuietButton}" Padding="16,11"
                      Click="BrowseButton_Click" DockPanel.Dock="Right" Margin="10,0,0,0" />
              <TextBox x:Name="InstallPathBox" Style="{StaticResource Field}"
                       TextChanged="InstallPathBox_TextChanged" />
            </DockPanel>
            <Border Background="#201E2C" CornerRadius="12" Padding="15" Margin="0,15,0,0">
              <StackPanel>
                <TextBlock Text="SPACE REQUIREMENTS" Foreground="#93C5FD"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,7" />
                <TextBlock x:Name="SpaceRequirementText" Foreground="#CBC8D5"
                           FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="SpaceAvailabilityText" Foreground="#A7B3C5"
                           FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <CheckBox x:Name="DesktopShortcutBox" IsChecked="True" Margin="0,20,0,0"
                      Foreground="#E5EEFF" FontSize="14" Content="Add a shortcut to my desktop"
                      Cursor="Hand" />
            <CheckBox x:Name="DetailedProgressBox" IsChecked="True" Margin="0,13,0,0"
                      Foreground="#E5EEFF" FontSize="14"
                      Content="Show detailed installation progress" Cursor="Hand" />
            <Border Background="#201E2C" CornerRadius="12" Padding="15" Margin="0,23,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦" Foreground="#93C5FD" FontSize="18" Margin="0,0,12,0" />
                <TextBlock Text="Your bookmarks and browser data stay on this computer."
                           Foreground="#CBC8D5" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ValidationMessage" Foreground="#FF9B9B" FontSize="12"
                       Visibility="Collapsed" Margin="0,10,0,0" />
          </StackPanel>
          <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Bottom">
            <Button Content="← Back" Style="{StaticResource QuietButton}" Click="BackButton_Click" />
            <Button x:Name="InstallButton" Content="Install Whister  →"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Click="InstallButton_Click" />
          </DockPanel>
        </Grid>

        <Grid x:Name="InstallingPage" Opacity="0" Visibility="Collapsed">
          <Grid.RenderTransform><TranslateTransform Y="12" /></Grid.RenderTransform>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <Grid Width="76" Height="76" Margin="0,0,0,28">
              <Ellipse Stroke="#343140" StrokeThickness="5" />
              <Ellipse Stroke="#60A5FA" StrokeThickness="5" StrokeDashArray="1.2 2.4"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotation" /></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <TextBlock Text="Getting things ready." Style="{StaticResource BodyText}" FontSize="30"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Whister is installing in the background. This can take a few minutes."
                       Style="{StaticResource SmallText}" FontSize="14" TextAlignment="Center"
                       Margin="0,12,0,0" />
            <DockPanel Margin="0,28,0,0">
              <TextBlock x:Name="InstallStatus" Text="Preparing installation…"
                         Style="{StaticResource SmallText}" FontSize="12"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="InstallPercent" Text="0%" Style="{StaticResource SmallText}"
                         FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right" />
            </DockPanel>
            <ProgressBar x:Name="InstallationProgressBar" Minimum="0" Maximum="100"
                         Value="0" Height="8" Margin="0,10,0,0"
                         Foreground="#60A5FA" Background="#2B2837"
                         IsIndeterminate="True" />
            <Border x:Name="InstallDetailsPanel" Visibility="Collapsed" Margin="0,16,0,0"
                    Padding="12" CornerRadius="10" Background="#101722"
                    BorderBrush="#2B3C52" BorderThickness="1">
              <StackPanel>
                <DockPanel Margin="0,0,0,7">
                  <TextBlock Text="LIVE INSTALL DETAILS" Foreground="#93C5FD"
                             FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="InstallElapsedText" Text="Elapsed 00:00"
                             Foreground="#A7B3C5" FontSize="10"
                             HorizontalAlignment="Right" DockPanel.Dock="Right" />
                </DockPanel>
                <TextBlock x:Name="InstallActivityText" Text="Preparing installer…"
                           Foreground="#E5EEFF" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="InstallSpaceText" Foreground="#A7B3C5"
                           FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBox x:Name="InstallLogTextBox" Height="104" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono" FontSize="10" Foreground="#C0DBFF"
                         Background="#101722" BorderBrush="#2B3C52" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid x:Name="CompletePage" Opacity="0" Visibility="Collapsed">
          <Grid.RenderTransform><TranslateTransform Y="12" /></Grid.RenderTransform>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="510">
            <Border Width="64" Height="64" CornerRadius="22" Background="#233B36"
                    HorizontalAlignment="Center" Margin="0,0,0,24">
              <TextBlock Text="✓" FontSize="30" Foreground="#8BE0B5" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="All set." Style="{StaticResource BodyText}" FontSize="36" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Whister is installed and ready when you are."
                       Style="{StaticResource SmallText}" FontSize="15" HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <CheckBox x:Name="LaunchBrowserBox" IsChecked="True" Content="Open Whister now"
                      Foreground="#E5EEFF" FontSize="14" HorizontalAlignment="Center"
                      Margin="0,27,0,0" Cursor="Hand" />
            <Button Content="Finish" Click="FinishButton_Click" Margin="0,24,0,0" MinWidth="150" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ErrorPage" Opacity="0" Visibility="Collapsed">
          <Grid.RenderTransform><TranslateTransform Y="12" /></Grid.RenderTransform>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
            <TextBlock Text="SETUP NEEDS ATTENTION" Foreground="#F6A6A6" FontSize="11"
                       FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="We couldn't finish." Style="{StaticResource BodyText}" FontSize="32"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
            <TextBlock x:Name="ErrorDetails" Style="{StaticResource SmallText}" TextAlignment="Center"
                       Margin="0,13,0,0" />
            <Button Content="Back to setup" Click="BackFromErrorButton_Click" Margin="0,26,0,0" />
          </StackPanel>
        </Grid>
      </Grid>

      <DockPanel Grid.Row="2" Margin="26,0" LastChildFill="False">
        <TextBlock Text="WHISTER BROWSER" Foreground="#6F6C7D" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Text="EXPERIMENTAL SETUP" Foreground="#6F6C7D" FontSize="10"
                   VerticalAlignment="Center" DockPanel.Dock="Right" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
