# --- Core Performance & Distribution Flags ---
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
is_official_build = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
chrome_pgo_phase = 0

# --- Privacy Hardening & Anti-Telemetry ---
enable_one_click_signin = false
enable_reporting = false
enable_mdns = false
enable_remoting = false
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# --- The Safe Browsing Network Sever ---
# We allow the files to compile so dependencies resolve, but we disable the cloud engines
safe_browsing_mode = 1
safe_browsing_use_locally_built_blocklists = false
optimize_webui = true
load_webui_from_disk = false
