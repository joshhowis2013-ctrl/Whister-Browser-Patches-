+        base::BindRepeating(&WhisterBlockerBubble::OnTogglePressed,
+                            base::Unretained(this))));
+    toggle_->SetPreferredSize(gfx::Size(52, 32));
+    toggle_->GetViewAccessibility().SetName(u"Enable Whister Blocker");
+    AddChildView(std::move(status_row));
+
+    status_label_ = AddChildView(std::make_unique<views::Label>());
+    status_label_->SetMultiLine(true);
+    status_label_->SetMaximumWidth(360);
+
+    auto rules_label = std::make_unique<views::Label>(
+        u"Built-in rules block known advertising and tracker requests. "
+        u"Consent dialogs are not ads and are not blocked.");
+    rules_label->SetMultiLine(true);
+    rules_label->SetMaximumWidth(360);
+    AddChildView(std::move(rules_label));
+
+    auto picker_button = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WhisterBlockerBubble::OnStartElementPicker,
+                            base::Unretained(this)),
+        u"Pick an element to block");
+    picker_button_ = AddChildView(std::move(picker_button));
+    auto picker_label = std::make_unique<views::Label>(
+        u"Choose a visible element on the current page. The selection applies "
+        u"until the page is reloaded.");
+    picker_label->SetMultiLine(true);
+    picker_label->SetMaximumWidth(360);
+    AddChildView(std::move(picker_label));
+
+    UpdateStatus(prefs_->GetBoolean("whister.blocker.enabled"));
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    constexpr int kMinimumWidth = 280;
+    constexpr int kPreferredWidth = 340;
+    constexpr int kMaximumWidth = 420;
+    const int width = available_size.width().is_bounded()
+                          ? std::clamp(available_size.width().value(),
+                                       kMinimumWidth, kMaximumWidth)
+                          : kPreferredWidth;
+    return gfx::Size(
+        width, GetLayoutManager()->GetPreferredHeightForWidth(this, width));
+  }
+
+ private:
+  void OnTogglePressed() {
+    const bool enabled = toggle_->GetIsOn();
+    prefs_->SetString("whister.blocker.ui", enabled ? "whister" : "off");
+    prefs_->SetBoolean("whister.blocker.enabled", enabled);
+    UpdateStatus(enabled);
+  }
+
+  void UpdateStatus(bool enabled) {
+    toggle_->SetIsOn(enabled);
+    status_label_->SetText(
+        enabled ? u"Active: " + base::NumberToString16(blocked_count_) +
+                      u" page elements hidden on the last checked page"
+                : u"Off: blocking is disabled");
+    picker_button_->SetEnabled(enabled);
+  }
+
+  void OnStartElementPicker() {
+    if (prefs_->GetBoolean("whister.blocker.enabled")) {
+      start_element_picker_.Run();
+    }
+  }
+
+  const raw_ptr<PrefService> prefs_;
+  base::RepeatingClosure start_element_picker_;
+  const int blocked_count_;
+  raw_ptr<views::Label> status_label_ = nullptr;
+  raw_ptr<views::ToggleButton> toggle_ = nullptr;
+  raw_ptr<views::LabelButton> picker_button_ = nullptr;
+};
