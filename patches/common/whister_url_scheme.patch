+      {GURL("whister://newtab"),
+       GURL("chrome://whister-newtab")},
+      {GURL("whister://whister-settings"),
+       GURL("chrome://whister-settings")},
+      {GURL("whister://setup"),
+       GURL("chrome://whister-setup")},
+      {GURL("whister://unknown"), GURL("whister://unknown")},
+      {GURL("whister://user@settings"), GURL("whister://user@settings")},
+      {GURL("whister://settings:80"), GURL("whister://settings:80")},
+  });
+}
