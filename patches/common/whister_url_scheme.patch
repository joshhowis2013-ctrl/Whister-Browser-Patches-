diff --git a/chrome/common/url_constants.h b/chrome/common/url_constants.h
--- a/chrome/common/url_constants.h
+++ b/chrome/common/url_constants.h
@@ -24,4 +24,6 @@ namespace chrome {
 
+inline constexpr char kWhisterScheme[] = "whister";
+
 // "Learn more" URL linked in the dialog to cast using a code.
 inline constexpr char kAccessCodeCastLearnMoreURL[] =
     "https://support.google.com/chrome/a/?p=cast_to_class_teacher";
diff --git a/chrome/common/chrome_content_client.cc b/chrome/common/chrome_content_client.cc
--- a/chrome/common/chrome_content_client.cc
+++ b/chrome/common/chrome_content_client.cc
@@ -194,3 +194,4 @@ static const char* const kChromeStandardURLSchemes[] = {
+    chrome::kWhisterScheme,
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
     extensions::kExtensionScheme,
 #endif
@@ -208,5 +209,6 @@ void ChromeContentClient::AddAdditionalSchemes(Schemes* schemes) {
   for (auto* standard_scheme : kChromeStandardURLSchemes)
     schemes->standard_schemes.push_back(standard_scheme);
+  schemes->secure_schemes.push_back(chrome::kWhisterScheme);
 
 #if BUILDFLAG(IS_ANDROID)
   schemes->referrer_schemes.push_back(content::kAndroidAppScheme);
diff --git a/chrome/browser/browser_about_handler.cc b/chrome/browser/browser_about_handler.cc
--- a/chrome/browser/browser_about_handler.cc
+++ b/chrome/browser/browser_about_handler.cc
@@ -53,6 +53,21 @@ bool HandleChromeAboutAndChromeSyncRewrite(
-  // Only handle chrome: URLs.
-  if (!url->SchemeIs(content::kChromeUIScheme)) {
+  const bool is_whister_url = url->SchemeIs(chrome::kWhisterScheme);
+  if (!url->SchemeIs(content::kChromeUIScheme) && !is_whister_url) {
     return false;
   }
+  if (is_whister_url &&
+      (url->has_username() || url->has_password() || url->has_port())) {
+    return false;
+  }
 
   std::string host(url->GetHost());
+  if (is_whister_url) {
+    if (host == "settings") {
+      host = chrome::kChromeUISettingsHost;
+    } else if (host == "newtab") {
+      host = "whister-newtab";
+    } else if (host == "setup") {
+      host = "whister-setup";
+    } else if (host != "whister-settings" && host != "whister-setup") {
+      return false;
+    }
+  }
@@ -78,5 +93,10 @@ bool HandleChromeAboutAndChromeSyncRewrite(
-  if (host != url->GetHost()) {
+  if (is_whister_url || host != url->GetHost()) {
     GURL::Replacements replacements;
-    replacements.SetHostStr(host);
+    if (host != url->GetHost()) {
+      replacements.SetHostStr(host);
+    }
+    if (is_whister_url) {
+      replacements.SetSchemeStr(content::kChromeUIScheme);
+    }
     *url = url->ReplaceComponents(replacements);
   }
