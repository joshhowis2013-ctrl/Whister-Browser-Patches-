diff --git a/chrome/tools/build/win/verify_whister_ubo_bundle.py b/chrome/tools/build/win/verify_whister_ubo_bundle.py
new file mode 100644
--- /dev/null
+++ b/chrome/tools/build/win/verify_whister_ubo_bundle.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+
+import json
+import pathlib
+import sys
+
+
+def main():
+    bundle_dir = pathlib.Path(sys.argv[1])
+    stamp_path = pathlib.Path(sys.argv[2])
+    manifest_path = bundle_dir / "manifest.json"
+    license_path = bundle_dir / "LICENSE.txt"
+
+    if not manifest_path.is_file():
+        raise FileNotFoundError(
+            f"uBlock Origin manifest missing: {manifest_path}"
+        )
+    if not license_path.is_file():
+        raise FileNotFoundError(
+            f"uBlock Origin license missing: {license_path}"
+        )
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if not manifest.get("key"):
+        raise ValueError(
+            f"uBlock Origin manifest has no public key: {manifest_path}"
+        )
+
+    stamp_path.parent.mkdir(parents=True, exist_ok=True)
+    stamp_path.write_text(
+        "uBlock Origin bundle verified\n", encoding="ascii"
+    )
+
+
+if __name__ == "__main__":
+    main()
