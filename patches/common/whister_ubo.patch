+void ComponentLoader::LoadUBlockOriginComponent() {
+  if (Exists(extension_misc::kUBlockOriginExtensionId)) {
+    return;
+  }
+
+  base::FilePath resources_dir;
+  if (!base::PathService::Get(chrome::DIR_RESOURCES, &resources_dir)) {
+    LOG(ERROR) << "Failed to locate uBlock Origin component resources.";
+    return;
+  }
+
+  const base::FilePath ublock_relative_dir(FILE_PATH_LITERAL("whister_ubo"));
+  std::string manifest;
+  if (!base::ReadFileToString(
+          resources_dir.Append(ublock_relative_dir)
+              .Append(FILE_PATH_LITERAL("manifest.json")),
+          &manifest)) {
+    VLOG(1) << "uBlock Origin component bundle is unavailable.";
+    return;
+  }
+
+  const ExtensionId extension_id = Add(manifest, ublock_relative_dir);
+  if (extension_id != extension_misc::kUBlockOriginExtensionId) {
+    LOG(ERROR) << "Failed to register uBlock Origin component.";
+  }
+}
