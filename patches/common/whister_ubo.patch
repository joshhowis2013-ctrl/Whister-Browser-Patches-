+void ToolbarActionsModel::MaybePinUBlockOrigin() {
+  const ActionId& extension_id = extension_misc::kUBlockOriginExtensionId;
+  if (profile_->IsOffTheRecord() || !action_ids_.contains(extension_id)) {
+    return;
+  }
+
+  bool default_pin_applied = false;
+  if (extension_prefs_->ReadPrefAsBoolean(
+          extension_id, kUBlockOriginDefaultPinAppliedPref,
+          &default_pin_applied)) {
+    return;
+  }
+
+  extension_prefs_->UpdateExtensionPref(
+      extension_id, kUBlockOriginDefaultPinAppliedPref, base::Value(true));
+  if (!IsActionPinned(extension_id)) {
+    SetActionVisibility(extension_id, true);
+  }
 }
 
