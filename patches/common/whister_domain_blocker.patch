 void ChromeContentRendererClient::RunScriptsAtDocumentStart(
     content::RenderFrame* render_frame) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "whister-blocker-enabled")) {
+    constexpr char kWhisterBlockerScript[] = R"JS(
+(() => {
+  'use strict';
+  if (location.protocol !== 'http:' && location.protocol !== 'https:') return;
+
+  const blockedDomains = [
+    'adnxs.com', 'ads.microsoft.com', 'ads.msn.com', 'adsrvr.org',
+    'amazon-adsystem.com', 'analytics.pinterest.com', 'analytics.tiktok.com',
+    'analytics.twitter.com', 'amplitude.com', 'api.amplitude.com',
+    'bat.bing.com', 'bluekai.com', 'casalemedia.com', 'clarity.ms',
+    'connect.facebook.net', 'criteo.com', 'criteo.net', 'ct.pinterest.com',
+    'demdex.net', 'doubleclick.net', 'events.reddit.com', 'everesttech.net',
+    'google-analytics.com', 'googleadservices.com', 'googlesyndication.com',
+    'googletagmanager.com', 'hotjar.com', 'krxd.net', 'matomo.cloud',
+    'mixpanel.com', 'mouseflow.com', 'omtrdc.net', 'openx.net', 'outbrain.com',
+    'pixel.facebook.com', 'pixel.reddit.com', 'pixel.wp.com', 'plausible.io',
+    'pubmatic.com', 'quantserve.com', 'rubiconproject.com',
+    'scorecardresearch.com', 'sc-static.net', 'segment.io', 'static.hotjar.com',
+    'stats.wp.com', 'taboola.com', 'tracking-protection.cdn.mozilla.net',
+    'tr.snapchat.com', 'yieldmo.com',
+  ];
+  const adMarker = /(^|[-_:\s])(ad|ads|adslot|adunit|adcontainer|advertisement|sponsored-ad)(?=$|[-_:\s])/i;
+  const isMsnPage = /(^|\.)msn\.com$/i.test(location.hostname);
+  const isBlockedUrl = value => {
+    try {
+      const host = new URL(value, location.href).hostname.toLowerCase();
+      return blockedDomains.some(domain => host === domain ||
+          host.endsWith(`.${domain}`));
+    } catch {
+      return false;
+    }
+  };
+  const hasAdMarker = element => {
+    if (element.matches('ins.adsbygoogle,[data-ad-client],[data-ad-slot]')) {
+      return true;
+    }
+    for (const attribute of element.attributes) {
+      if ((attribute.name.startsWith('data-') ||
+           attribute.name === 'id' || attribute.name === 'class') &&
+          adMarker.test(`${attribute.name} ${attribute.value}`)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  const isMsnDisplayPlacement = element => {
+    if (!isMsnPage) return false;
+    if (element.matches(
+            'div.ad-container, div.ad-slot, div[data-ad-container], ' +
+            'div[data-ad-slot], div[id^="ad-container-"], ' +
+            'div[id^="ad-slot-"]')) {
+      return true;
+    }
+    if (element.tagName !== 'IFRAME') return false;
+    if (/^(google_ads_iframe|aswift)_/i.test(element.id) ||
+        /^(google_ads_iframe|aswift)_/i.test(element.name)) {
+      return true;
+    }
+    try {
+      const host = new URL(element.src, location.href).hostname.toLowerCase();
+      return host === 'ads.microsoft.com' ||
+          host.endsWith('.ads.microsoft.com') || host === 'ads.msn.com';
+    } catch {
+      return false;
+    }
+  };
+  const hide = element => {
+    if (element.hasAttribute('data-whister-blocked')) return;
+    element.style.setProperty('display', 'none', 'important');
+    element.setAttribute('data-whister-blocked', 'true');
+    const root = document.documentElement;
+    root.dataset.whisterBlockedCount =
+        String((Number(root.dataset.whisterBlockedCount) || 0) + 1);
+  };
+  const filterElement = element => {
+    if (!(element instanceof Element) ||
+        element.hasAttribute('data-whister-blocked')) {
+      return;
+    }
+    if (isMsnDisplayPlacement(element) || element.matches('ins.adsbygoogle') ||
+        (element.tagName === 'IFRAME' &&
+         (isBlockedUrl(element.src) || hasAdMarker(element)))) {
+      hide(element);
+      return;
+    }
+    if (hasAdMarker(element) &&
+        element.querySelector('iframe, ins.adsbygoogle, .adsbygoogle')) {
+      hide(element);
+    }
+  };
+  const filterSubtree = root => {
+    if (!(root instanceof Element)) return;
+    filterElement(root);
+    for (const element of root.querySelectorAll(
+             'iframe, ins.adsbygoogle, .adsbygoogle, [data-ad-client], ' +
+             '[data-ad-slot], [id], [class]')) {
+      filterElement(element);
+    }
+    for (let parent = root.parentElement, depth = 0;
+         parent && depth < 3; parent = parent.parentElement, ++depth) {
+      filterElement(parent);
+    }
+  };
+  const filterDuckDuckGoPromo = root => {
+    if (!/(^|\.)duckduckgo\.com$/i.test(location.hostname)) return;
+    const dialogs = root instanceof Element &&
+            root.matches('[role="dialog"], dialog') ? [root] :
+            root.querySelectorAll?.('[role="dialog"], dialog') || [];
+    for (const dialog of dialogs) {
+      const text = dialog.textContent || '';
+      if (text.includes('Upgrade to our browser') &&
+          text.includes('Get the free DuckDuckGo Browser to block ads on YouTube')) {
+        hide(dialog);
+      }
+    }
+  };
+  const filter = root => {
+    filterSubtree(root);
+    filterDuckDuckGoPromo(root);
+  };
+  let pickerCleanup = null;
+  document.addEventListener('whister-start-element-picker', () => {
+    if (pickerCleanup) return;
+    const overlay = document.createElement('div');
+    Object.assign(overlay.style, {
+      position: 'fixed', pointerEvents: 'none', zIndex: '2147483647',
+      border: '2px solid #4285f4', background: 'rgba(66, 133, 244, .12)',
+    });
+    document.documentElement.append(overlay);
+    let target = null;
+    const positionOverlay = element => {
+      const rect = element.getBoundingClientRect();
+      Object.assign(overlay.style, {
+        left: `${rect.left}px`, top: `${rect.top}px`,
+        width: `${rect.width}px`, height: `${rect.height}px`,
+      });
+    };
+    const onMove = event => {
+      target = event.target instanceof Element ? event.target : null;
+      if (target && target !== overlay) positionOverlay(target);
+    };
+    const cleanup = () => {
+      document.removeEventListener('mousemove', onMove, true);
+      document.removeEventListener('click', onClick, true);
+      document.removeEventListener('keydown', onKey, true);
+      overlay.remove();
+      pickerCleanup = null;
+    };
+    const onClick = event => {
+      if (!target || target === document.documentElement ||
+          target === document.body) return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      hide(target);
+      cleanup();
+    };
+    const onKey = event => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        cleanup();
+      }
+    };
+    pickerCleanup = cleanup;
+    document.addEventListener('mousemove', onMove, true);
+    document.addEventListener('click', onClick, true);
+    document.addEventListener('keydown', onKey, true);
+  });
+  filter(document.documentElement);
+  new MutationObserver(records => {
+    for (const record of records) {
+      if (record.type === 'attributes') {
+        filter(record.target);
+      }
+      for (const node of record.addedNodes) filter(node);
+    }
+  }).observe(document, {
+    subtree: true,
+    childList: true,
+    attributes: true,
+    attributeFilter: ['class', 'id', 'src', 'data-ad-client', 'data-ad-slot'],
+  });
+})();
+)JS";
+    render_frame->GetWebFrame()->ExecuteScript(
+        blink::WebScriptSource(blink::WebString::FromAscii(
+            kWhisterBlockerScript)));
+  }
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   extensions::ExtensionsRendererClient::Get()->RunScriptsAtDocumentStart(
       render_frame);
