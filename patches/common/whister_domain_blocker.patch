+
+#ifndef CHROME_BROWSER_WHISTER_BLOCKER_WHISTER_DOMAIN_BLOCKER_URL_LOADER_THROTTLE_H_
+#define CHROME_BROWSER_WHISTER_BLOCKER_WHISTER_DOMAIN_BLOCKER_URL_LOADER_THROTTLE_H_
+
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+
+class GURL;
+
+namespace net {
+struct RedirectInfo;
+}  // namespace net
+
+namespace network {
+struct HttpRequestHeadersUpdateParams;
+struct ResourceRequest;
+}  // namespace network
+
+namespace whister_blocker {
+
+class WhisterDomainBlockerURLLoaderThrottle : public blink::URLLoaderThrottle {
+ public:
+  explicit WhisterDomainBlockerURLLoaderThrottle(bool enabled);
+  ~WhisterDomainBlockerURLLoaderThrottle() override;
+
+  WhisterDomainBlockerURLLoaderThrottle(
+      const WhisterDomainBlockerURLLoaderThrottle&) = delete;
+  WhisterDomainBlockerURLLoaderThrottle& operator=(
+      const WhisterDomainBlockerURLLoaderThrottle&) = delete;
+
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override;
+
+ private:
+  bool ShouldBlock(const GURL& url) const;
+
+  const bool enabled_;
+};
+
+}  // namespace whister_blocker
+
+#endif  // CHROME_BROWSER_WHISTER_BLOCKER_WHISTER_DOMAIN_BLOCKER_URL_LOADER_THROTTLE_H_
