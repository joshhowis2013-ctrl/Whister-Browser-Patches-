+// Copyright 2026 Whister Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/whister_blocker/whister_domain_blocker_url_loader_throttle.h"
+
+#include <array>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "net/base/net_errors.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "url/gurl.h"
+
+namespace whister_blocker {
+
+namespace {
+
+constexpr std::array<std::string_view, 50> kBlockedDomains = {
+    "adnxs.com",
+    "ads.microsoft.com",
+    "ads.msn.com",
+    "adsrvr.org",
+    "amazon-adsystem.com",
+    "analytics.pinterest.com",
+    "analytics.tiktok.com",
+    "analytics.twitter.com",
+    "amplitude.com",
+    "api.amplitude.com",
+    "bat.bing.com",
+    "bluekai.com",
+    "casalemedia.com",
+    "clarity.ms",
+    "connect.facebook.net",
+    "criteo.com",
+    "criteo.net",
+    "ct.pinterest.com",
+    "demdex.net",
+    "doubleclick.net",
+    "events.reddit.com",
+    "everesttech.net",
+    "google-analytics.com",
+    "googleadservices.com",
+    "googlesyndication.com",
+    "googletagmanager.com",
+    "hotjar.com",
+    "krxd.net",
+    "matomo.cloud",
+    "mixpanel.com",
+    "mouseflow.com",
+    "omtrdc.net",
+    "openx.net",
+    "outbrain.com",
+    "pixel.facebook.com",
+    "pixel.reddit.com",
+    "pixel.wp.com",
+    "plausible.io",
+    "pubmatic.com",
+    "quantserve.com",
+    "rubiconproject.com",
+    "scorecardresearch.com",
+    "sc-static.net",
+    "segment.io",
+    "static.hotjar.com",
+    "stats.wp.com",
+    "taboola.com",
+    "tracking-protection.cdn.mozilla.net",
+    "tr.snapchat.com",
+    "yieldmo.com",
+};
+
+bool HostMatchesDomain(std::string_view host, std::string_view domain) {
+  return base::EqualsCaseInsensitiveASCII(host, domain) ||
+         (host.size() > domain.size() &&
+          host[host.size() - domain.size() - 1] == '.' &&
+          base::EndsWith(host, domain,
+                         base::CompareCase::INSENSITIVE_ASCII));
+}
+
+}  // namespace
+
+WhisterDomainBlockerURLLoaderThrottle::WhisterDomainBlockerURLLoaderThrottle(
+    bool enabled)
+    : enabled_(enabled) {}
+
+WhisterDomainBlockerURLLoaderThrottle::~WhisterDomainBlockerURLLoaderThrottle() =
+    default;
+
+void WhisterDomainBlockerURLLoaderThrottle::WillStartRequest(
+    network::ResourceRequest* request,
+    bool* defer) {
+  if (ShouldBlock(request->url)) {
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, "Whister Blocker");
+  }
+}
+
+void WhisterDomainBlockerURLLoaderThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    bool* defer,
+    network::HttpRequestHeadersUpdateParams* headers_update_params) {
+  if (ShouldBlock(redirect_info->new_url)) {
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, "Whister Blocker");
+  }
+}
+
+bool WhisterDomainBlockerURLLoaderThrottle::ShouldBlock(const GURL& url) const {
+  if (!enabled_ || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+
+  for (std::string_view domain : kBlockedDomains) {
+    if (HostMatchesDomain(url.host(), domain)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace whister_blocker
